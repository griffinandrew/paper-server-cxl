# Defaults to localhost
host=127.0.0.1

# Default port
port=3145

# Maximum size of the cache specified in bytes
max_size=2GiB

# Byte budget of the FAST (DRAM) tier. Values beyond it are demoted to the
# slow (PMEM/CXL) tier. Must not exceed max_size.
fast_tier_size=512MiB

# The configured eviction policies of the cache
# Possible values:
# - lfu
# - fifo
# - clock
# - sieve
# - lru
# - mru
# - 2q-<K_in>-<K_out>
# - arc
# - s3-fifo-<ratio>
# NOTE: `policies[]` is parsed but unused by this build. The tiered cache has
# no runtime policy switching and no `auto` policy, so the design is fixed at
# startup by `policy` below. The list is kept so stock config files still load.
policies[]=lru

# The eviction policy, fixed for the process lifetime. This build serves the
# TIERED designs; a flat policy name such as `lru` or `auto` will be rejected.
# Possible values:
# - lru-hybrid
# - lfu-hybrid
# - fifo-hybrid
# - lru-lfu-hybrid-<promote_k>
# - lru-sized-hybrid
# - 2q-hybrid-<k_in>
# - 2q-ghost-hybrid-<k_in>
# - 2q-fast-admission-hybrid-<k_in>
# - 2q-fast-admission-reprieve-hybrid-<k_in>
# - 2q-full-fast-admission-hybrid-<k_in>-<k_out>
# - s3-fifo-hybrid-<ratio>
# - s3-fifo-ghost-hybrid-<ratio>
# - s3-fifo-ghost-lazy-demotion-hybrid-<ratio>
# - s3-fifo-ghost-lazy-demotion-fast-admission-hybrid-<ratio>
# - s3-fifo-ghost-lazy-demotion-fast-admission-midpoint-hybrid-<ratio>
# - s3-fifo-lazy-demotion-reprieve-hybrid-<ratio>
# - s3-fifo-lazy-demotion-fast-admission-reprieve-hybrid-<ratio>
# - s3-fifo-lazy-demotion-fast-admission-midpoint-reprieve-hybrid-<ratio>
# - s3-fifo-lazy-demotion-fast-admission-split-slow-reprieve-hybrid-<ratio>
policy=lru-hybrid

# Maximum number of concurrent connections
max_connections=50

# Authorization token (optional)
# If set, clients must supply this token to send commands
# auth_token=<your_auth_token>
