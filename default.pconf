# Defaults to localhost
host=127.0.0.1

# Default port
port=3145

# Maximum size of the cache specified in bytes
max_size=2GiB

# Byte budget of the FAST (DRAM) tier. Values beyond it are demoted to the
# slow (PMEM/CXL) tier. Must not exceed max_size. Ignored by the all_dram build,
# which has no slow tier.
fast_tier_size=512MiB

# NOTE: a stock config's `policies[]` lines are accepted and ignored, with a
# warning at start-up. A cache's policy is fixed when it is built, there is no
# `auto` policy and nothing switches it at run time, so only `policy` below
# counts, and the names listed are not checked against the ones this cache knows.

# The eviction policy, fixed for the process lifetime. The cache hosts every
# design in one build and the policy picks one at start-up; a build that cannot
# serve the one named refuses to start.
#
# The default (tiered) build serves the hybrid designs:
# - lru-compact-hybrid
# - lfu-compact-hybrid
# - fifo-compact-hybrid
# - clock-compact-hybrid
# - lru-lfu-compact-hybrid-<promote_k>
# - 2q-compact-hybrid-<k_in>
# - 2q-ghost-compact-hybrid-<k_in>
# - 2q-fast-admission-reprieve-compact-hybrid-<k_in>
# - 2q-full-fast-admission-compact-hybrid-<k_in>-<k_out>
# - s3-fifo-compact-hybrid-<ratio>
# - s3-fifo-ghost-compact-hybrid-<ratio>
# - s3-fifo-ghost-lazy-demotion-compact-hybrid-<ratio>
# - s3-fifo-ghost-lazy-demotion-fast-admission-compact-hybrid-<ratio>
# - s3-fifo-ghost-lazy-demotion-fast-admission-midpoint-compact-hybrid-<ratio>
# - s3-fifo-lazy-demotion-reprieve-compact-hybrid-<ratio>
# - s3-fifo-lazy-demotion-fast-admission-reprieve-compact-hybrid-<ratio>
# - s3-fifo-lazy-demotion-fast-admission-midpoint-reprieve-compact-hybrid-<ratio>
# - s3-fifo-lazy-demotion-fast-admission-split-slow-reprieve-compact-hybrid-<ratio>
# - s3-fifo-faithful-compact-hybrid-<ratio>
# - s3-fifo-faithful-fast-admission-compact-hybrid-<ratio>
# - s3-fifo-faithful-reprieve-compact-hybrid-<ratio>
# - s3-fifo-faithful-fast-admission-reprieve-compact-hybrid-<ratio>
# (the 23rd, lru-sized-compact-hybrid, has a constructor of its own that this
# server does not use). A merged_object_store build serves only the lru, lfu,
# fifo and clock ones.
#
# The all_dram build serves the flat designs instead, and defaults to
# lru-compact:
# - lru-compact
# - lfu-compact
# - fifo-compact
# - clock-compact
# - sieve-compact
# - mru-compact
# - 2q-compact-<k_in>-<k_out>
# - arc
# - s3-fifo-compact-<ratio>
policy=lru-compact-hybrid

# Maximum number of concurrent connections
max_connections=50

# Authorization token (optional)
# If set, clients must supply this token to send commands
# auth_token=<your_auth_token>
